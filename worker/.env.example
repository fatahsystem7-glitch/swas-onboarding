# sitering-receptionist worker — environment
# The worker connects to the SAME LiveKit project and DB as the API service.

# LiveKit Cloud (must match the API service)
LIVEKIT_URL=wss://1t7smtelwif.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Registered agent name — MUST equal the name used in the dispatch rule
AGENT_NAME=sitering-receptionist

# Voice pipeline provider keys
DEEPGRAM_API_KEY=      # STT
OPENAI_API_KEY=        # LLM + TTS

# Read-only access to the same Postgres the API writes to
DATABASE_URL=postgres://postgres:postgres@localhost:5432/swas

# Where to POST call results when a call ends
SWAS_API_BASE_URL=http://localhost:3000
INTERNAL_API_TOKEN=    # must match the API service's INTERNAL_API_TOKEN (optional)
