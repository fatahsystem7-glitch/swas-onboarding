# ─────────────────────────────────────────────────────────────
# SwaS Onboarding & Telephony Engine — Environment Variables
# Copy to `.env` for local dev. On Railway, set these in the
# service's `Variables` tab. Never commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# App
PORT=3000
NODE_ENV=development
# Public base URL of this service (used to build Telnyx webhook callback URLs)
PUBLIC_BASE_URL=https://your-service.up.railway.app

# When true, external providers (Telnyx/LiveKit/Resend/S3) are stubbed so the
# server boots and endpoints respond without live credentials. Great for local
# development and CI. Set to "false" in production.
MOCK_PROVIDERS=true

# ── Telnyx ──────────────────────────────────────────────────
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# The Telnyx SIP Connection ID that points at LiveKit (numbers get assigned here)
TELNYX_SIP_CONNECTION_ID=

# ── LiveKit Cloud ───────────────────────────────────────────
LIVEKIT_URL=https://1t7smtelwif.sip.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The agent/worker name calls are dispatched to
LIVEKIT_AGENT_NAME=sitering-receptionist

# ── Email (Resend by default) ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="SiteRing <onboarding@yourdomain.co.uk>"

# ── Storage (S3 for call recordings) ────────────────────────
S3_BUCKET_NAME=
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# If not using S3, recordings fall back to this local/volume directory
LOCAL_STORAGE_DIR=./storage/recordings

# ── Database ────────────────────────────────────────────────
# Provided automatically by Railway PostgreSQL plugin
DATABASE_URL=postgres://postgres:postgres@localhost:5432/swas
